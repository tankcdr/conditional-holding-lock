# Copy to .env.localnet (gitignored). scripts/localnet.sh does this for you.
#
# This drives Splice's own localnet compose stack, vendored verbatim under
# localnet-overrides/splice-<IMAGE_TAG>/. IMAGE_TAG is the Splice release tag
# and selects every Splice image (canton, splice-app, the web UIs) at once:
# Splice publishes the Canton image it pairs with under the same tag, so there
# is no separate CANTON_VERSION to keep in step.
#
# IMAGE_TAG must equal the Splice version live on Canton Mainnet.
# `just check-compatibility` fails when it does not; `just localnet-sync`
# re-syncs both this file and the overrides directory to live Mainnet.

IMAGE_TAG=0.8.0
IMAGE_REPO=ghcr.io/digital-asset/decentralized-canton-sync/docker/

# The vendored Splice localnet tree. Relative to the repository root;
# scripts/lib/localnet-compose.sh makes it absolute before calling compose.
LOCALNET_DIR=./localnet-overrides/splice-0.8.0

# Required by Splice's compose.yaml, format <company>-<role>-<number>.
PARTY_HINT=conditionallock-localparty-1

# Distinct from any other project's localnet on this machine.
DOCKER_NETWORK=conditional-lock-localnet

# All three validators on: sv (global synchronizer + scan), app-provider, app-user.
SV_PROFILE=on
APP_PROVIDER_PROFILE=on
APP_USER_PROFILE=on

# Host postgres port. 5432 is often taken by another project's stack.
DB_PORT=5433

# The app-provider participant, which is what we upload DARs to and run the
# reference deployment against. Port pattern is <node><suffix>: 3 = app-provider,
# 4 = sv, 2 = app-user; 901 ledger (gRPC), 902 admin, 975 JSON API, 903 validator.
LEDGER_JSON_API=http://localhost:3975
LEDGER_HOST=127.0.0.1
LEDGER_PORT=3901
