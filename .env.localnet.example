# Copy to .env.localnet (gitignored).
# Version pairing: splice-app 0.6.7 + canton 0.6.8.

SPLICE_VERSION=0.6.7
CANTON_VERSION=0.6.8
SPLICE_IMAGE_REPO=ghcr.io/digital-asset/decentralized-canton-sync/docker/

LOCALNET_DIR=./localnet/quickstart/docker/modules/localnet
LOCALNET_ENV_DIR=./localnet/quickstart/docker/modules/localnet/env

SV_PROFILE=on
APP_PROVIDER_PROFILE=on
APP_USER_PROFILE=on

PARTY_HINT=conditionallock-localparty-1

CANTON_API_URL=http://localhost:3975
CANTON_NETWORK_MODE=localnet
