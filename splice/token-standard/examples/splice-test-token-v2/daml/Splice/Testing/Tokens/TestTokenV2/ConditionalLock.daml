-- | TestTokenV2 implementation of splice-api-token-conditional-lock-v1.
--
-- Receiver parties that accept (or co-sign a one-step lock) become signatories
-- of the lock contract. Enact therefore has their authority -- and the owner's,
-- captured at creation -- without requiring the owner to act.
module Splice.Testing.Tokens.TestTokenV2.ConditionalLock
( TokenConditionalLockInstruction(..)
, TokenConditionalLock(..)
, factoryMeta
, token_conditionalLockFactory_lockExtraObservers
, token_conditionalLockFactory_lockImpl
) where

import DA.Assert (assertDeadlineExceeded)
import DA.List (dedupSort, (\\))
import DA.TextMap qualified as TextMap
import DA.Crypto.Text qualified as Crypto

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferEventsV2 qualified as TransferEventsV2
import Splice.Api.Token.ConditionalLockV1 qualified as CL
import Splice.Testing.Tokens.TestTokenV2.Holding
import Splice.TokenStandard.Utils


factoryMeta : Metadata
factoryMeta = Metadata $ TextMap.fromList
  [ (maxRulesMetaKey, "8")
  , (maxLegsMetaKey, "8")
  , (maxGuardDepthMetaKey, "3")
  , (maxDurationMetaKey, "P365D")
  , (minDurationMetaKey, "PT1S")
  ]

mkLockId : CL.LockTerms -> Text
mkLockId terms =
  Crypto.sha256 (Crypto.toHex (terms.instrumentId.id <> show terms.requestedAt <> show terms.amount))

lockContextText : CL.LockTerms -> Optional Text
lockContextText terms =
  case lockContextFromMeta terms.meta of
    Some ctx -> Some ctx
    None -> Some "conditional-lock"

holdingMeta : CL.LockTerms -> Metadata
holdingMeta terms =
  case lockContextFromMeta terms.meta of
    Some _ -> terms.meta
    None -> Metadata $ TextMap.insert lockContextKey "conditional-lock" terms.meta.values

mkLockedHoldingView : Party -> CL.LockTerms -> V2.HoldingView
mkLockedHoldingView admin terms = V2.HoldingView with
  account = terms.owner
  instrumentId = terms.instrumentId
  amount = terms.amount
  lock = Some V2.Lock with
    holders = namedPartiesOf admin terms
    expiresAt = Some terms.expiresAt
    expiresAfter = None
    context = lockContextText terms
  meta = holdingMeta terms

unlockedHoldingView : V2.Account -> V2.InstrumentId -> Decimal -> V2.HoldingView
unlockedHoldingView account instrumentId amount = V2.HoldingView with
  account
  instrumentId
  amount
  lock = None
  meta = emptyMetadata

token_conditionalLockFactory_lockExtraObservers : CL.ConditionalLockFactory_Lock -> [Party]
token_conditionalLockFactory_lockExtraObservers arg =
  ownerPartiesOf arg.terms.instrumentId.admin arg.terms

validateLockTerms : Party -> Time -> CL.LockTerms -> Update ()
validateLockTerms admin now terms = do
  requireMatchExpected ("terms.instrumentId.admin", terms.instrumentId.admin) admin
  assertDeadlineExceeded "terms.requestedAt" terms.requestedAt
  require "terms.expiresAt must be in the future" (now < terms.expiresAt)
  require "terms are well-formed" $
    isWellFormedTerms defaultMaxRules defaultMaxLegs defaultMaxGuardDepth terms

debitUnlockedInputs
  : V2.InstrumentId -> V2.Account -> Decimal -> [ContractId V2.Holding]
  -> Update [ContractId V2.Holding]
debitUnlockedInputs instrumentId owner amount inputHoldingCids = do
  inputAmounts <- forA inputHoldingCids $ \cid -> do
    token <- fetchAndArchiveUnlockedToken instrumentId owner (coerceContractId cid)
    pure token.holding.amount
  let inputAmount = sum inputAmounts
  require' ("inputAmount", inputAmount) isGreaterOrEqualR ("lock.amount", amount)
  let remainder = inputAmount - amount
  if remainder <= 0.0 then pure []
  else do
    cid <- create Token with
      holding = unlockedHoldingView owner instrumentId remainder
    pure [toInterfaceContractId cid]

createLockedBacking : Party -> CL.LockTerms -> Update (ContractId V2.Holding)
createLockedBacking admin terms = do
  cid <- create Token with
    holding = mkLockedHoldingView admin terms
  pure (toInterfaceContractId cid)

-- | Pending instruction. Accepted receiver parties are signatories so the last
-- accept can create the lock without going back to the owner.
template TokenConditionalLockInstruction with
    terms : CL.LockTerms
    pendingReceivers : [V2.Account]
    acceptedReceiverParties : [Party]
    inputHoldingCids : [ContractId V2.Holding]
    ownerChangeCids : [ContractId V2.Holding]
    lockId : Text
    eventLogCid : ContractId TransferEventsV2.EventLog
    meta : Metadata
  where
    signatory
      terms.instrumentId.admin,
      ownerPartiesOf terms.instrumentId.admin terms,
      acceptedReceiverParties
    observer namedPartiesOf terms.instrumentId.admin terms
    ensure
      not (null pendingReceivers) &&
      isWellFormedTerms defaultMaxRules defaultMaxLegs defaultMaxGuardDepth terms

    interface instance CL.ConditionalLockInstruction for TokenConditionalLockInstruction where
      view = CL.ConditionalLockInstructionView with
        terms
        pendingReceivers
        meta

      conditionalLockInstruction_acceptImpl = token_instruction_acceptImpl this
      conditionalLockInstruction_rejectImpl = token_instruction_rejectImpl this
      conditionalLockInstruction_withdrawImpl = token_instruction_withdrawImpl this

-- | Active lock. Owner and accepted receiver parties are signatories, so Enact
-- (controlled by the enactor) can move funds without a new owner signature.
template TokenConditionalLock with
    lockId : Text
    terms : CL.LockTerms
    holdingCid : ContractId V2.Holding
    receiverParties : [Party]
    eventLogCid : ContractId TransferEventsV2.EventLog
    meta : Metadata
  where
    signatory
      terms.instrumentId.admin,
      ownerPartiesOf terms.instrumentId.admin terms,
      receiverParties
    observer namedPartiesOf terms.instrumentId.admin terms
    ensure isWellFormedTerms defaultMaxRules defaultMaxLegs defaultMaxGuardDepth terms

    interface instance CL.ConditionalLock for TokenConditionalLock where
      view = CL.ConditionalLockView with
        lockId
        terms
        holdingCid
        meta

      conditionalLock_enactImpl = token_lock_enactImpl this
      conditionalLock_expireImpl = token_lock_expireImpl this
      conditionalLock_cancelImpl = token_lock_cancelImpl this
      conditionalLock_amendImpl = token_lock_amendImpl this

token_conditionalLockFactory_lockImpl
  : Party
  -> ContractId TransferEventsV2.EventLog
  -> ContractId CL.ConditionalLockFactory
  -> CL.ConditionalLockFactory_Lock
  -> Update CL.ConditionalLockResult
token_conditionalLockFactory_lockImpl admin eventLogCid _self arg = do
  let terms = arg.terms
  now <- getTime
  validateLockTerms admin now terms
  require "actors include owner parties" $
    all (`elem` arg.actors) (ownerPartiesOf admin terms)

  ownerChangeCids <- debitUnlockedInputs
    terms.instrumentId terms.owner terms.amount arg.inputHoldingCids
  holdingCid <- createLockedBacking admin terms
  let lockId = mkLockId terms

  logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
    admin
    account = terms.owner
    inputHoldingCids = arg.inputHoldingCids
    transferLegSides = []
    outputHoldingCids = holdingCid :: ownerChangeCids
    observers = ownerPartiesOf admin terms <> namedPartiesOf admin terms
    extraArgs = ExtraArgs with
      context = emptyChoiceContext
      meta = reasonToMeta "conditional lock" $
        Metadata $ TextMap.insert txKindMetaKey "lock" emptyMetadata.values

  let receiverParties = requiredReceiverParties admin terms
  if all (`elem` arg.actors) receiverParties
    then do
      lockCid <- create TokenConditionalLock with
        lockId
        terms
        holdingCid
        receiverParties
        eventLogCid
        meta = emptyMetadata
      pure CL.ConditionalLockResult with
        output = CL.ConditionalLockResult_Locked with
          lockCid = toInterfaceContractId lockCid
          holdingCid
          ownerChangeCids
        meta = emptyMetadata
    else do
      instrCid <- create TokenConditionalLockInstruction with
        terms
        pendingReceivers = termsReceivers terms
        acceptedReceiverParties = []
        inputHoldingCids = [holdingCid]
        ownerChangeCids
        lockId
        eventLogCid
        meta = emptyMetadata
      pure CL.ConditionalLockResult with
        output = CL.ConditionalLockResult_Pending (toInterfaceContractId instrCid)
        meta = emptyMetadata

token_instruction_acceptImpl
  : TokenConditionalLockInstruction
  -> ContractId CL.ConditionalLockInstruction
  -> CL.ConditionalLockInstruction_Accept
  -> Update CL.ConditionalLockResult
token_instruction_acceptImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLockInstruction)
  let admin = this.terms.instrumentId.admin
  require "receiver is pending" (arg.receiver `elem` this.pendingReceivers)
  require "actors include receiver parties" $
    all (`elem` arg.actors) (accountParties admin arg.receiver)
  let remaining = filter (/= arg.receiver) this.pendingReceivers
  let accepted = dedupSort (this.acceptedReceiverParties <> accountParties admin arg.receiver)
  if null remaining
    then do
      holdingCid <- case this.inputHoldingCids of
        [cid] -> pure cid
        xs -> abort $ "Expected exactly one backing holding, got " <> show (length xs)
      lockCid <- create TokenConditionalLock with
        lockId = this.lockId
        terms = this.terms
        holdingCid
        receiverParties = accepted
        eventLogCid = this.eventLogCid
        meta = emptyMetadata
      logHoldingsChange this.eventLogCid TransferEventsV2.EventLog_HoldingsChange with
        admin
        account = this.terms.owner
        inputHoldingCids = []
        transferLegSides = []
        outputHoldingCids = []
        observers = ownerPartiesOf admin this.terms <> namedPartiesOf admin this.terms
        extraArgs = ExtraArgs with
          context = emptyChoiceContext
          meta = reasonToMeta "conditional lock accepted" $
            Metadata $ TextMap.insert txKindMetaKey "lock" emptyMetadata.values
      pure CL.ConditionalLockResult with
        output = CL.ConditionalLockResult_Locked with
          lockCid = toInterfaceContractId lockCid
          holdingCid
          ownerChangeCids = this.ownerChangeCids
        meta = emptyMetadata
    else do
      instrCid <- create this with
        pendingReceivers = remaining
        acceptedReceiverParties = accepted
      pure CL.ConditionalLockResult with
        output = CL.ConditionalLockResult_Pending (toInterfaceContractId instrCid)
        meta = emptyMetadata

unlockInstructionHoldings : TokenConditionalLockInstruction -> Update [ContractId V2.Holding]
unlockInstructionHoldings this = do
  forA this.inputHoldingCids $ \cid -> do
    token <- fetchAndArchiveLockedToken this.terms.instrumentId this.terms.owner (coerceContractId cid)
    newCid <- create Token with
      holding = unlockedHoldingView this.terms.owner token.holding.instrumentId token.holding.amount
    pure (toInterfaceContractId newCid)

token_instruction_rejectImpl
  : TokenConditionalLockInstruction
  -> ContractId CL.ConditionalLockInstruction
  -> CL.ConditionalLockInstruction_Reject
  -> Update CL.ConditionalLockResult
token_instruction_rejectImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLockInstruction)
  let admin = this.terms.instrumentId.admin
  require "receiver is pending" (arg.receiver `elem` this.pendingReceivers)
  require "actors include receiver parties" $
    all (`elem` arg.actors) (accountParties admin arg.receiver)
  ownerHoldingCids <- unlockInstructionHoldings this
  logUnlock this.eventLogCid admin this.terms "conditional lock rejected" ownerHoldingCids this.inputHoldingCids
  pure CL.ConditionalLockResult with
    output = CL.ConditionalLockResult_Failed
    meta = reasonToMeta "rejected" emptyMetadata

token_instruction_withdrawImpl
  : TokenConditionalLockInstruction
  -> ContractId CL.ConditionalLockInstruction
  -> CL.ConditionalLockInstruction_Withdraw
  -> Update CL.ConditionalLockResult
token_instruction_withdrawImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLockInstruction)
  let admin = this.terms.instrumentId.admin
  now <- getTime
  let ownerOk = all (`elem` arg.actors) (ownerPartiesOf admin this.terms)
  -- Owner may always withdraw; after expiry they MUST be allowed to regardless of receivers.
  require "actors include owner parties" (ownerOk || now >= this.terms.expiresAt && ownerOk)
  require "actors include owner parties" ownerOk
  ownerHoldingCids <- unlockInstructionHoldings this
  logUnlock this.eventLogCid admin this.terms "conditional lock withdrawn" ownerHoldingCids this.inputHoldingCids
  pure CL.ConditionalLockResult with
    output = CL.ConditionalLockResult_Failed
    meta = reasonToMeta "withdrawn" emptyMetadata

logUnlock
  : ContractId TransferEventsV2.EventLog
  -> Party -> CL.LockTerms -> Text
  -> [ContractId V2.Holding] -> [ContractId V2.Holding]
  -> Update ()
logUnlock eventLogCid admin terms reason outputs inputs =
  logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
    admin
    account = terms.owner
    inputHoldingCids = inputs
    transferLegSides = []
    outputHoldingCids = outputs
    observers = ownerPartiesOf admin terms
    extraArgs = ExtraArgs with
      context = emptyChoiceContext
      meta = reasonToMeta reason $
        Metadata $ TextMap.insert txKindMetaKey "unlock" emptyMetadata.values

token_lock_enactImpl
  : TokenConditionalLock
  -> ContractId CL.ConditionalLock
  -> CL.ConditionalLock_Enact
  -> Update CL.ConditionalLockResult
token_lock_enactImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLock)
  now <- getTime
  require "cannot enact at or after expiry" (now < this.terms.expiresAt)
  let matching = filter (\r -> r.id == arg.ruleId) this.terms.rules
  rule <- expectOneElement "rule" (\r -> r.id) matching
  require "an enactor is among actors" (any (`elem` arg.actors) rule.enactors)
  require "guard is satisfied" $
    guardSatisfied now arg.actors arg.witness rule.guard
  applyOutcome this this.eventLogCid this.lockId arg.ruleId rule.outcome arg.legs arg.extraArgs
    (this.terms with rules = filter (\r -> r.id /= rule.id) this.terms.rules)

token_lock_expireImpl
  : TokenConditionalLock
  -> ContractId CL.ConditionalLock
  -> CL.ConditionalLock_Expire
  -> Update CL.ConditionalLockResult
token_lock_expireImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLock)
  let admin = this.terms.instrumentId.admin
  now <- getTime
  require "cannot expire before expiry" (now >= this.terms.expiresAt)
  require "actors include owner parties or admin" $
    all (`elem` arg.actors) (ownerPartiesOf admin this.terms) ||
    arg.actors == [admin]
  applyOutcome this this.eventLogCid this.lockId "fallback" this.terms.fallback arg.legs arg.extraArgs
    (this.terms with rules = [])

token_lock_cancelImpl
  : TokenConditionalLock
  -> ContractId CL.ConditionalLock
  -> CL.ConditionalLock_Cancel
  -> Update CL.ConditionalLockResult
token_lock_cancelImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLock)
  let admin = this.terms.instrumentId.admin
  let required = ownerPartiesOf admin this.terms <> namedPartiesOf admin this.terms
  require "cancel requires owner and every named party" $
    all (`elem` arg.actors) required
  applyOutcome this this.eventLogCid this.lockId "cancel" CL.Outcome_Unlock None arg.extraArgs
    (this.terms with rules = [])

token_lock_amendImpl
  : TokenConditionalLock
  -> ContractId CL.ConditionalLock
  -> CL.ConditionalLock_Amend
  -> Update CL.ConditionalLockResult
token_lock_amendImpl this self arg = do
  archive (coerceContractId self : ContractId TokenConditionalLock)
  let admin = this.terms.instrumentId.admin
  now <- getTime
  let required = ownerPartiesOf admin this.terms <> namedPartiesOf admin this.terms
  require "amend requires owner and every named party" $
    all (`elem` arg.actors) required
  requireMatchExpected ("newTerms.owner", arg.newTerms.owner) this.terms.owner
  requireMatchExpected ("newTerms.instrumentId", arg.newTerms.instrumentId) this.terms.instrumentId
  validateLockTerms admin now arg.newTerms
  require "new amount covers current plus additional inputs" (arg.newTerms.amount >= this.terms.amount)
  let additional = arg.newTerms.amount - this.terms.amount
  additionalChange <-
    if additional == 0.0
      then do
        require "no additional inputs when amount is unchanged" (null arg.additionalInputHoldingCids)
        pure []
      else debitUnlockedInputs
        arg.newTerms.instrumentId arg.newTerms.owner additional arg.additionalInputHoldingCids
  _ <- fetchAndArchiveLockedToken this.terms.instrumentId this.terms.owner (coerceContractId this.holdingCid)
  let newReceivers = termsReceivers arg.newTerms \\ termsReceivers this.terms
  holdingCid <- createLockedBacking admin arg.newTerms
  if null newReceivers
    then do
      lockCid <- create TokenConditionalLock with
        lockId = this.lockId
        terms = arg.newTerms
        holdingCid
        receiverParties = requiredReceiverParties admin arg.newTerms
        eventLogCid = this.eventLogCid
        meta = emptyMetadata
      pure CL.ConditionalLockResult with
        output = CL.ConditionalLockResult_Locked with
          lockCid = toInterfaceContractId lockCid
          holdingCid
          ownerChangeCids = additionalChange
        meta = emptyMetadata
    else do
      instrCid <- create TokenConditionalLockInstruction with
        terms = arg.newTerms
        pendingReceivers = newReceivers
        acceptedReceiverParties = requiredReceiverParties admin this.terms
        inputHoldingCids = [holdingCid]
        ownerChangeCids = additionalChange
        lockId = this.lockId
        eventLogCid = this.eventLogCid
        meta = emptyMetadata
      pure CL.ConditionalLockResult with
        output = CL.ConditionalLockResult_Pending (toInterfaceContractId instrCid)
        meta = emptyMetadata

applyOutcome
  : TokenConditionalLock
  -> ContractId TransferEventsV2.EventLog
  -> Text
  -> Text
  -> CL.Outcome
  -> Optional [CL.Leg]
  -> ExtraArgs
  -> CL.LockTerms
  -> Update CL.ConditionalLockResult
applyOutcome this eventLogCid lockId ruleId outcome suppliedLegs extraArgs remainingTerms = do
  let admin = this.terms.instrumentId.admin
  let amount = this.terms.amount
  -- Unlock returns the full remaining amount to the owner and terminates.
  let unlockLegs = [CL.Leg with receiver = this.terms.owner, amount = amount]
  legs <- case outcome of
    CL.Outcome_Unlock -> pure unlockLegs
    _ -> case resolveOutcomeLegs outcome suppliedLegs of
      None -> abort $ "invalid legs for outcome of rule " <> ruleId
      Some ls -> pure ls
  remainder <- case remainingAfterLegs amount legs of
    None -> abort $ "legs exceed remaining amount for rule " <> ruleId
    Some r -> pure r
  _ <- fetchAndArchiveLockedToken this.terms.instrumentId this.terms.owner
        (coerceContractId this.holdingCid)

  created <- forA legs $ \leg -> do
    cid <- create Token with
      holding = unlockedHoldingView leg.receiver this.terms.instrumentId leg.amount
    pure (leg, toInterfaceContractId cid : ContractId V2.Holding)

  let receiverHoldingCids =
        map snd (filter (\(leg, _) -> leg.receiver /= this.terms.owner) created)
  let ownerHoldingCids =
        map snd (filter (\(leg, _) -> leg.receiver == this.terms.owner) created)

  continuationCid <-
    if remainder > 0.0
      then do
        let contTerms = remainingTerms with amount = remainder
        holdingCid <- createLockedBacking admin contTerms
        lockCid <- create TokenConditionalLock with
          lockId
          terms = contTerms
          holdingCid
          receiverParties = this.receiverParties
          eventLogCid
          meta = this.meta
        logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
          admin
          account = this.terms.owner
          inputHoldingCids = [this.holdingCid]
          transferLegSides = []
          outputHoldingCids = holdingCid :: ownerHoldingCids
          observers = ownerPartiesOf admin this.terms <> namedPartiesOf admin this.terms
          extraArgs = ExtraArgs with
            context = emptyChoiceContext
            meta = reasonToMeta ("conditional lock " <> ruleId) extraArgs.meta
        pure (Some (toInterfaceContractId lockCid))
      else do
        logEnactment eventLogCid this lockId ruleId created
        pure None

  let txKind =
        if null receiverHoldingCids then "unlock" else "transfer"
  let resultMeta = Metadata $ TextMap.fromList $
        [ (txKindMetaKey, txKind)
        , (ruleIdMetaKey, ruleId)
        ]

  pure CL.ConditionalLockResult with
    output = CL.ConditionalLockResult_Enacted with
      receiverHoldingCids
      ownerHoldingCids
      continuationCid
    meta = resultMeta

logEnactment
  : ContractId TransferEventsV2.EventLog
  -> TokenConditionalLock
  -> Text -> Text
  -> [(CL.Leg, ContractId V2.Holding)]
  -> Update ()
logEnactment eventLogCid this lockId ruleId created = do
  let admin = this.terms.instrumentId.admin
  let transferLegs = filter (\(leg, _) -> leg.receiver /= this.terms.owner) created
  let ownerCids = map snd (filter (\(leg, _) -> leg.receiver == this.terms.owner) created)
  if null transferLegs
    then
      logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
        admin
        account = this.terms.owner
        inputHoldingCids = [this.holdingCid]
        transferLegSides = []
        outputHoldingCids = ownerCids
        observers = ownerPartiesOf admin this.terms
        extraArgs = ExtraArgs with
          context = emptyChoiceContext
          meta = reasonToMeta ruleId $
            Metadata $ TextMap.insert txKindMetaKey "unlock" emptyMetadata.values
    else do
      forA transferLegs $ \(leg, _cid) -> do
        let legId = lockId <> "/" <> ruleId
        logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
          admin
          account = this.terms.owner
          inputHoldingCids = [this.holdingCid]
          transferLegSides =
            [ TransferEventsV2.TransferLegSide with
                transferLegId = legId
                side = TransferEventsV2.SenderSide
                otherside = leg.receiver
                amount = leg.amount
                instrumentId = this.terms.instrumentId.id
                meta = emptyMetadata
            ]
          outputHoldingCids = ownerCids
          observers = ownerPartiesOf admin this.terms <> accountParties admin leg.receiver
          extraArgs = ExtraArgs with
            context = emptyChoiceContext
            meta = Metadata $ TextMap.fromList
              [ (txKindMetaKey, "transfer")
              , (ruleIdMetaKey, ruleId)
              ]
        logHoldingsChange eventLogCid TransferEventsV2.EventLog_HoldingsChange with
          admin
          account = leg.receiver
          inputHoldingCids = []
          transferLegSides =
            [ TransferEventsV2.TransferLegSide with
                transferLegId = legId
                side = TransferEventsV2.ReceiverSide
                otherside = this.terms.owner
                amount = leg.amount
                instrumentId = this.terms.instrumentId.id
                meta = emptyMetadata
            ]
          outputHoldingCids = map snd (filter (\(l, _) -> l.receiver == leg.receiver) created)
          observers = accountParties admin leg.receiver
          extraArgs = ExtraArgs with
            context = emptyChoiceContext
            meta = Metadata $ TextMap.fromList
              [ (txKindMetaKey, "transfer")
              , (ruleIdMetaKey, ruleId)
              ]
      pure ()
