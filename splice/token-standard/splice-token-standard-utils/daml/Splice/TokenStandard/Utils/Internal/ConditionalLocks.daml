-- | Shared guard evaluation and conservation checks for conditional locks.
--
-- Every registry MUST use these functions so that a given `LockTerms` is
-- enactable iff it is enactable against any other conforming registry.
module Splice.TokenStandard.Utils.Internal.ConditionalLocks (
  emptyWitness,
  digestHexLength,
  isLowercaseHex,
  isHexDigest,
  isHexPreimage,
  hashPreimage,
  guardDepth,
  guardSatisfied,
  isWellFormedGuard,
  isWellFormedOutcome,
  isWellFormedRule,
  isWellFormedTerms,
  outcomeReceivers,
  termsReceivers,
  termsEnactors,
  termsGuardParties,
  namedPartiesOf,
  ownerPartiesOf,
  requiredReceiverParties,
  legsSum,
  legsPositive,
  resolveOutcomeLegs,
  remainingAfterLegs,
  lockContextKey,
  lockContextFromMeta,
  ruleIdMetaKey,
  maxRulesMetaKey,
  maxLegsMetaKey,
  maxGuardDepthMetaKey,
  maxDurationMetaKey,
  minDurationMetaKey,
  defaultMaxRules,
  defaultMaxLegs,
  defaultMaxGuardDepth,
) where

import DA.List (dedupSort, (\\))
import DA.Text qualified as T
import DA.TextMap qualified as TextMap
import DA.Crypto.Text qualified as Crypto

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.ConditionalLockV1 qualified as CL
import Splice.TokenStandard.Utils.Internal.Conversions


emptyWitness : CL.Witness
emptyWitness = CL.Witness with preimages = []

digestHexLength : Int
digestHexLength = 64

defaultMaxRules : Int
defaultMaxRules = 8

defaultMaxLegs : Int
defaultMaxLegs = 8

defaultMaxGuardDepth : Int
defaultMaxGuardDepth = 3

lockContextKey : Text
lockContextKey = "splice.lfdecentralizedtrust.org/lock-context"

ruleIdMetaKey : Text
ruleIdMetaKey = "splice.lfdecentralizedtrust.org/conditional-lock/rule-id"

maxRulesMetaKey : Text
maxRulesMetaKey = "splice.lfdecentralizedtrust.org/conditional-lock/max-rules"

maxLegsMetaKey : Text
maxLegsMetaKey = "splice.lfdecentralizedtrust.org/conditional-lock/max-legs"

maxGuardDepthMetaKey : Text
maxGuardDepthMetaKey = "splice.lfdecentralizedtrust.org/conditional-lock/max-guard-depth"

maxDurationMetaKey : Text
maxDurationMetaKey = "splice.lfdecentralizedtrust.org/conditional-lock/max-duration"

minDurationMetaKey : Text
minDurationMetaKey = "splice.lfdecentralizedtrust.org/conditional-lock/min-duration"

isLowercaseHex : Text -> Bool
isLowercaseHex t =
  T.length t > 0 && T.length t % 2 == 0 && T.isPred (\c -> c >= "0" && c <= "9" || c >= "a" && c <= "f") t

isHexDigest : Text -> Bool
isHexDigest t = isLowercaseHex t && T.length t == digestHexLength

isHexPreimage : Text -> Bool
isHexPreimage t = isLowercaseHex t && T.length t == digestHexLength

hashPreimage : CL.HashAlgorithm -> Text -> Text
hashPreimage CL.Sha256 preimage = Crypto.sha256 (T.asciiToLower preimage)
hashPreimage CL.Keccak256 preimage = Crypto.keccak256 (T.asciiToLower preimage)

guardDepth : CL.Guard -> Int
guardDepth (CL.Guard_All gs) = 1 + foldl max 0 (map guardDepth gs)
guardDepth (CL.Guard_Any gs) = 1 + foldl max 0 (map guardDepth gs)
guardDepth _ = 1

preimageHitsDigest : CL.HashAlgorithm -> Text -> [Text] -> Bool
preimageHitsDigest algorithm digest preimages =
  any (\p -> isHexPreimage p && hashPreimage algorithm p == digest) (map T.asciiToLower preimages)

guardSatisfied : Time -> [Party] -> CL.Witness -> CL.Guard -> Bool
guardSatisfied now actors witness guard = case guard of
  CL.Guard_Preimage algorithm digest ->
    preimageHitsDigest algorithm digest witness.preimages
  CL.Guard_After time ->
    now >= time
  CL.Guard_Before time ->
    now < time
  CL.Guard_Parties parties threshold ->
    let hits = dedupSort (filter (`elem` actors) parties)
    in length hits >= threshold
  CL.Guard_All guards ->
    all (guardSatisfied now actors witness) guards
  CL.Guard_Any guards ->
    any (guardSatisfied now actors witness) guards

isWellFormedGuardNode : CL.Guard -> Bool
isWellFormedGuardNode g = case g of
  CL.Guard_Preimage _ digest -> isHexDigest digest
  CL.Guard_After _ -> True
  CL.Guard_Before _ -> True
  CL.Guard_Parties parties threshold ->
    length parties == length (dedupSort parties) &&
    threshold >= 1 &&
    threshold <= length parties
  CL.Guard_All guards ->
    not (null guards) && all isWellFormedGuardNode guards
  CL.Guard_Any guards ->
    not (null guards) && all isWellFormedGuardNode guards

isWellFormedGuard : Int -> CL.Guard -> Bool
isWellFormedGuard maxDepth guard =
  guardDepth guard <= maxDepth && isWellFormedGuardNode guard

legsPositive : [CL.Leg] -> Bool
legsPositive = all (\leg -> leg.amount > 0.0)

legsSum : [CL.Leg] -> Decimal
legsSum legs = sum (map (\leg -> leg.amount) legs)

isWellFormedOutcome : Decimal -> Int -> CL.Outcome -> Bool
isWellFormedOutcome amount maxLegs outcome = case outcome of
  CL.Outcome_Unlock -> True
  CL.Outcome_Transfer legs ->
    not (null legs) &&
    length legs <= maxLegs &&
    legsPositive legs &&
    legsSum legs <= amount
  CL.Outcome_Distribute receivers ->
    not (null receivers) &&
    length receivers <= maxLegs &&
    length receivers == length (dedupSort receivers)

isWellFormedRule : Decimal -> Int -> Int -> CL.Rule -> Bool
isWellFormedRule amount maxLegs maxDepth rule =
  rule.id /= "" &&
  not (null rule.enactors) &&
  isWellFormedGuard maxDepth rule.guard &&
  isWellFormedOutcome amount maxLegs rule.outcome

isWellFormedTerms : Int -> Int -> Int -> CL.LockTerms -> Bool
isWellFormedTerms maxRules maxLegs maxDepth terms =
  terms.amount > 0.0 &&
  length terms.rules <= maxRules &&
  length ruleIds == length (dedupSort ruleIds) &&
  all (isWellFormedRule terms.amount maxLegs maxDepth) terms.rules &&
  isWellFormedOutcome terms.amount maxLegs terms.fallback
  where
    ruleIds = map (\r -> r.id) terms.rules

outcomeReceivers : CL.LockTerms -> CL.Outcome -> [V2.Account]
outcomeReceivers terms outcome = case outcome of
  CL.Outcome_Unlock -> []
  CL.Outcome_Transfer legs ->
    map (\leg -> leg.receiver) (filter (\leg -> leg.receiver /= terms.owner) legs)
  CL.Outcome_Distribute receivers ->
    filter (/= terms.owner) receivers

termsReceivers : CL.LockTerms -> [V2.Account]
termsReceivers terms =
  dedupSort $
    concatMap (outcomeReceivers terms) (map (\r -> r.outcome) terms.rules) <>
    outcomeReceivers terms terms.fallback

termsEnactors : CL.LockTerms -> [Party]
termsEnactors terms = dedupSort $ concatMap (\r -> r.enactors) terms.rules

guardParties : CL.Guard -> [Party]
guardParties guard = case guard of
  CL.Guard_Parties parties _ -> parties
  CL.Guard_All gs -> concatMap guardParties gs
  CL.Guard_Any gs -> concatMap guardParties gs
  _ -> []

termsGuardParties : CL.LockTerms -> [Party]
termsGuardParties terms =
  dedupSort $ concatMap (\r -> guardParties r.guard) terms.rules

ownerPartiesOf : Party -> CL.LockTerms -> [Party]
ownerPartiesOf admin terms = accountParties admin terms.owner

namedPartiesOf : Party -> CL.LockTerms -> [Party]
namedPartiesOf admin terms =
  let receiverParties = concatMap (accountParties admin) (termsReceivers terms)
      allNamed = receiverParties <> termsEnactors terms <> termsGuardParties terms
  in dedupSort allNamed \\ ownerPartiesOf admin terms

requiredReceiverParties : Party -> CL.LockTerms -> [Party]
requiredReceiverParties admin terms =
  dedupSort $ concatMap (accountParties admin) (termsReceivers terms)

resolveOutcomeLegs : CL.Outcome -> Optional [CL.Leg] -> Optional [CL.Leg]
resolveOutcomeLegs outcome supplied = case (outcome, supplied) of
  (CL.Outcome_Unlock, None) -> Some []
  (CL.Outcome_Transfer legs, None) -> Some legs
  (CL.Outcome_Distribute receivers, Some legs) ->
    if legsPositive legs &&
       all (\leg -> leg.receiver `elem` receivers) legs
    then Some legs
    else None
  _ -> None

remainingAfterLegs : Decimal -> [CL.Leg] -> Optional Decimal
remainingAfterLegs amount legs =
  if not (legsPositive legs) then None
  else
    let spent = legsSum legs
    in if spent > amount then None else Some (amount - spent)

lockContextFromMeta : Metadata -> Optional Text
lockContextFromMeta meta = TextMap.lookup lockContextKey meta.values
