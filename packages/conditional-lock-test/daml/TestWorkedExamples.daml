module TestWorkedExamples where

import DA.Assert
import DA.Foldable (forA_)
import DA.List (dedup, head, tail)
import DA.Optional (fromSome)
import DA.Text qualified as Text
import DA.TextMap qualified as TextMap
import DA.Time
import Daml.Script
import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.TransferEventsV2 qualified as Events
import Splice.Api.Token.ConditionalLockV1 qualified as CL
import Splice.Testing.Tokens.TestTokenV2 qualified as Token
import ConditionalLock.Policy
  ( accountParties, namedParties, termReceivers, lockHolders, metadata, prefix )
import ConditionalLock.TestToken qualified as Impl
import Generated.HashVectors (vectors)
import TestConditionalLock
  ( setup, account, termsFor, mint, factory, extra
  , asLocked, asPending, enactArg, approveArg, assertToken, assertConsumed
  , failsBecause, holdingsChanges )

type LockHandle = (ContractId CL.ConditionalLock, ContractId V2.Holding)

-- Reuse the reference registry and funding helpers. Each workflow has its own
-- registry-issued ID. The authorizer locks first; each approver accepts
-- separately. Guard parties and enactors do not accept unless they are also
-- approvers.
lockAccepted : ContractId Token.TokenRules -> Text -> CL.LockTerms -> Script LockHandle
lockAccepted rules lockId terms = do
  input <- mint terms terms.amount
  f <- factory rules terms lockId
  let owners = accountParties terms.authorizer
  result <- submit (actAs owners <> readAs [terms.instrumentId.admin]) $
    exerciseCmd f $ CL.ConditionalLockFactory_Lock terms [input] owners extra
  accepted <- acceptApprovals terms result (termReceivers terms)
  handle <- asLocked accepted
  checkLive (fromSome terms.authorizer.owner) lockId terms handle
  pure handle

acceptApprovals : CL.LockTerms -> CL.ConditionalLockResult -> [V2.Account] -> Script CL.ConditionalLockResult
acceptApprovals _ result [] = pure result
acceptApprovals terms result (approver :: rest) = do
  cid <- asPending result
  Some view <- queryInterfaceContractId (fromSome terms.authorizer.owner) cid
  view.pendingApprovals === approver :: rest
  let actors = accountParties approver
  accepted <- submit (actAs actors) $ exerciseCmd cid $
    CL.ConditionalLockInstruction_Accept approver actors extra
  acceptApprovals terms accepted rest

checkLive : Party -> Text -> CL.LockTerms -> LockHandle -> Script ()
checkLive party lockId terms (cid, holding) = do
  Some view <- queryInterfaceContractId party cid
  view.lockId === lockId
  view.terms === terms
  view.holdingCids === [holding]
  Some backing <- queryInterfaceContractId party holding
  backing.account === terms.authorizer
  backing.instrumentId === terms.instrumentId
  backing.amount === terms.amount
  let backingLock = fromSome backing.lock
  backingLock.holders === lockHolders terms
  backingLock.expiresAt === Some terms.expiresAt
  backingLock.expiresAfter === None
  -- CIP section 3.4: the lock context and the holding metadata carry the same text.
  TextMap.lookup (prefix <> "lock-context") backing.meta.values === backingLock.context

assertBalance : Party -> V2.Account -> V2.InstrumentId -> Decimal -> Script ()
assertBalance party owner instrument amount = do
  tokens <- query @Token.Token party
  let owned = [ t.holding | (_, t) <- tokens,
        t.holding.account == owner, t.holding.instrumentId == instrument ]
  sum (map (.amount) owned) === amount
  assert (all (\h -> h.lock == None) owned)

-- | Every key/value of `expected` appears in `actual`. Used to check that a
-- transfer leg's meta carries the registry keys and the leg's own keys
-- without requiring an exact match.
containsMeta : Metadata -> Metadata -> Script ()
containsMeta expected actual = forA_ (TextMap.toList expected.values) $ \(k, v) ->
  TextMap.lookup k actual.values === Some v

-- Inspect the actual V2 event choices in the enactment transaction and resolve
-- their output CIDs to published TestTokenV2 holdings. A continuation must have
-- exactly the expected terms and a matching backing; a terminal lock is absent.
-- Filtering by registry lets the same assertions inspect each half of a DvP.
checkEnactment : Party -> Text -> CL.LockTerms -> LockHandle -> Optional Text -> [CL.Leg]
  -> Optional CL.LockTerms -> [TreeEvent] -> Script (Optional LockHandle, [Text])
checkEnactment party lockId terms (cid, holding) ruleId legs expectedNext roots = do
  assertConsumed party cid holding
  locks <- query @Impl.ActiveLock party
  let matching = [ (toInterfaceContractId nextCid, toInterfaceContractId active.state.holdingCid)
        | (nextCid, active) <- locks, active.state.lockId == lockId ]
  next <- case (expectedNext, matching) of
    (None, []) -> pure None
    (Some nextTerms, [handle]) -> do
      nextTerms.amount === terms.amount - sum (map (.amount) legs)
      checkLive party lockId nextTerms handle
      Some nextView <- queryInterfaceContractId party (fst handle)
      assert (fromSome ruleId `elem` nextView.enactedRuleIds)
      pure (Some handle)
    _ -> abort "unexpected terminal or continuing lock state"
  let changes = filter (\event -> event.admin == terms.instrumentId.admin) (holdingsChanges roots)
  let receivers = dedup [ leg.receiver | leg <- legs, leg.receiver /= terms.authorizer ]
  map (.account) changes === terms.authorizer :: receivers
  let authorizerChange = head changes
  authorizerChange.inputHoldingCids === [holding]
  let authorizerLegs = filter (\leg -> leg.receiver == terms.authorizer) legs
  let authorizerOutputs = take (length authorizerLegs) authorizerChange.outputHoldingCids
  length authorizerOutputs === length authorizerLegs
  forA_ (zip authorizerLegs authorizerOutputs) $ \(leg, out) ->
    assertToken party out terms.authorizer terms.instrumentId leg.amount
  drop (length authorizerLegs) authorizerChange.outputHoldingCids === optional [] (pure . snd) next
  let outgoing = authorizerChange.transferLegSides
  let transfers = filter (\leg -> leg.receiver /= terms.authorizer) legs
  map (.amount) outgoing === map (.amount) transfers
  map (.otherside) outgoing === map (.receiver) transfers
  map (.side) outgoing === replicate (length transfers) Events.SenderSide
  let ids = map (.transferLegId) outgoing
  length (dedup ids) === length transfers
  let kind = if null transfers then "unlock" else "transfer"
  forA_ changes $ \event -> do
    TextMap.lookup (prefix <> "tx-kind") event.extraArgs.meta.values === Some kind
    TextMap.lookup (prefix <> "conditional-lock/rule-id") event.extraArgs.meta.values === ruleId
  forA_ (zip transfers outgoing) $ \(leg, side) -> do
    side.instrumentId === terms.instrumentId.id
    case Text.splitOn "/" side.transferLegId of
      [eventLock, eventRule, eventLeg] -> do
        eventLock === lockId
        eventRule === fromSome ruleId
        eventLeg === leg.legId
      _ -> abort "leg ID must carry lock ID, rule ID, and leg ID"
    containsMeta authorizerChange.extraArgs.meta side.meta
    containsMeta leg.meta side.meta
  forA_ (tail changes) $ \received -> do
    received.inputHoldingCids === []
    let receivedLegs = filter (\leg -> leg.receiver == received.account) transfers
    length received.outputHoldingCids === length receivedLegs
    forA_ (zip receivedLegs received.outputHoldingCids) $ \(leg, out) ->
      assertToken (fromSome received.account.owner) out received.account terms.instrumentId leg.amount
    let sent = filter (\side -> side.otherside == received.account) outgoing
    let expectedSides = map (\side -> side with side = Events.ReceiverSide; otherside = terms.authorizer) sent
    received.transferLegSides === expectedSides
  pure (next, ids)

-- | CIP section 4, item 1: HTLC leg.
-- Alice locks 100 X; Bob's claim requires SHA-256 H and transfers 100 to Bob.
-- Expiry is t0 + 24h; expiry returns the funds to Alice, unlocked. Alice
-- funds, then Bob accepts.
test_example_htlcLeg : Script ()
test_example_htlcLeg = do
  e <- setup ()
  let (_, preimage, sha, _) = head vectors
  let (_, wrongPreimage, _, _) = fromSome $ find (\(id, _, _, _) -> id == "0x01-repeated") vectors
  let payout = [CL.Leg "claim" (account e.bob) 100.0 emptyMetadata]
  -- The wallet describes the lock; the registry carries that text into
  -- `Lock.context` and the holding's lock-context metadata rather than its own.
  let htlc env algorithm digest = (termsFor env) with
        rules = [CL.Rule "claim" [e.bob] [CL.Alternative [CL.Guard_Preimage algorithm digest]] (CL.Outcome_Release payout [])]
        meta = metadata [(prefix <> "lock-context", "hashlock to Bob")]
  let terms = htlc e CL.Sha256 sha
  first@(cid, backing) <- lockAccepted e.rulesA "htlc-claim" terms
  -- The wallet's description reaches the holding, rather than the registry default.
  Some described <- queryInterfaceContractId e.alice backing
  (fromSome described.lock).context === Some "hashlock to Bob"
  submitMustFail e.bob $ exerciseCmd cid $
    (enactArg "claim" [e.bob]) with witness = CL.Witness [wrongPreimage]
  tree <- submitTree e.bob $ exerciseCmd cid $
    (enactArg "claim" [e.bob]) with witness = CL.Witness [preimage]
  _ <- checkEnactment e.alice "htlc-claim" terms first (Some "claim") payout None tree.rootEvents
  assertBalance e.bob (account e.bob) terms.instrumentId 100.0

  second@(expiredCid, _) <- lockAccepted e.rulesA "htlc-expiry" terms
  setTime terms.expiresAt
  submitMustFail e.bob $ exerciseCmd expiredCid $
    (enactArg "claim" [e.bob]) with witness = CL.Witness [preimage]
  checkLive e.alice "htlc-expiry" terms second
  refunded <- submitTree e.alice $ exerciseCmd expiredCid $ CL.ConditionalLock_Expire [e.alice] extra
  _ <- checkEnactment e.alice "htlc-expiry" terms second None
    [CL.Leg "expire" terms.authorizer 100.0 emptyMetadata] None refunded.rootEvents
  assertBalance e.alice terms.authorizer terms.instrumentId 100.0

  now <- getTime
  -- Use bytes 00..1f for casing and algorithm selection. Unlike the zero
  -- vector, its uppercase form differs. Both algorithms must accept those
  -- same bytes under their own digest and reject the other algorithm's digest.
  let (_, letters, lettersSha, lettersKeccak) = fromSome $
        find (\(id, _, _, _) -> id == "ascending-bytes") vectors
  let uppercase = Text.asciiToUpper letters
  assert (uppercase /= letters)
  forA_ [("keccak", CL.Keccak256, lettersKeccak), ("sha256", CL.Sha256, lettersSha)] $
    \(name, algorithm, digest) -> do
      let validTerms = htlc (e with now) algorithm digest
      let lockId = "htlc-" <> name
      valid@(validCid, _) <- lockAccepted e.rulesA lockId validTerms
      submitMustFail e.bob $ exerciseCmd validCid $
        (enactArg "claim" [e.bob]) with witness = CL.Witness [wrongPreimage]
      validTree <- submitTree e.bob $ exerciseCmd validCid $
        (enactArg "claim" [e.bob]) with witness = CL.Witness [uppercase]
      _ <- checkEnactment e.alice lockId validTerms valid (Some "claim") payout None validTree.rootEvents
      pure ()
  assertBalance e.bob (account e.bob) terms.instrumentId 300.0

  -- Cross-paired digests catch an implementation that dispatches to the wrong
  -- hash or accepts either hash regardless of the agreed algorithm. Use the
  -- lowercase witness here so rejection cannot be caused by uppercase parsing.
  mismatched <- forA [("sha-with-keccak-digest", CL.Sha256, lettersKeccak),
                      ("keccak-with-sha-digest", CL.Keccak256, lettersSha)] $
    \(name, algorithm, digest) -> do
      let mismatchTerms = htlc (e with now) algorithm digest
      handle <- lockAccepted e.rulesA name mismatchTerms
      submitMustFail e.bob $ exerciseCmd (fst handle) $
        (enactArg "claim" [e.bob]) with witness = CL.Witness [letters]
      checkLive e.alice name mismatchTerms handle
      pure (name, mismatchTerms, handle)
  assertBalance e.bob (account e.bob) terms.instrumentId 300.0
  setTime (now `addRelTime` hours 24)
  forA_ mismatched $ \(name, mismatchTerms, handle) -> do
    refundTree <- submitTree e.alice $ exerciseCmd (fst handle) $
      CL.ConditionalLock_Expire [e.alice] extra
    _ <- checkEnactment e.alice name mismatchTerms handle None
      [CL.Leg "expire" terms.authorizer 100.0 emptyMetadata] None refundTree.rootEvents
    pure ()
  assertBalance e.alice terms.authorizer terms.instrumentId 300.0

-- | CIP section 4, item 2: DvP across two registries.
-- Alice locks 100 X under AX and Bob locks 50 Y under AY. The two settle
-- rules are enacted jointly by Alice and Bob, each requiring their two-party
-- threshold. Each transfers to the other account; expiry at t0 + 24h returns
-- any remaining amount to its authorizer, unlocked.
test_example_dvpBetweenRegistries : Script ()
test_example_dvpBetweenRegistries = do
  e <- setup ()
  let actors = [e.alice, e.bob]
  let policyGuard = CL.Guard_Parties actors 2
  let xLegs = [CL.Leg "settle" (account e.bob) 100.0 emptyMetadata]
  let yLegs = [CL.Leg "settle" (account e.alice) 50.0 emptyMetadata]
  let x = (termsFor e) with
        rules = [CL.Rule "settle" actors [CL.Alternative [policyGuard]] (CL.Outcome_Release xLegs [])]
  let y = x with
        authorizer = account e.bob
        instrumentId = V2.InstrumentId e.adminB "Y"
        amount = 50.0
        rules = [CL.Rule "settle" actors [CL.Alternative [policyGuard]] (CL.Outcome_Release yLegs [])]
  assert (x.instrumentId.admin /= y.instrumentId.admin)
  xFirst@(xCid, _) <- lockAccepted e.rulesA "dvp-x" x
  yFirst@(yCid, _) <- lockAccepted e.rulesB "dvp-y" y
  tree <- submitTree (actAs actors <> readAs [e.adminA, e.adminB]) $
    exerciseCmd xCid (enactArg "settle" actors) *>
    exerciseCmd yCid (enactArg "settle" actors)
  length tree.rootEvents === 2
  (_, xIds) <- checkEnactment e.alice "dvp-x" x xFirst (Some "settle") xLegs None tree.rootEvents
  (_, yIds) <- checkEnactment e.bob "dvp-y" y yFirst (Some "settle") yLegs None tree.rootEvents
  length (dedup (xIds <> yIds)) === 2
  assertBalance e.bob (account e.bob) x.instrumentId 100.0
  assertBalance e.alice (account e.alice) y.instrumentId 50.0

  xSecond@(xRetry, _) <- lockAccepted e.rulesA "dvp-rollback-x" x
  ySecond@(yRetry, _) <- lockAccepted e.rulesB "dvp-rollback-y" y
  -- Alice is an enactor but cannot meet the two-party guard by herself.
  submitMustFail e.alice $ exerciseCmd xRetry $ enactArg "settle" [e.alice]
  beforeAlice <- query @Token.Token e.alice
  beforeBob <- query @Token.Token e.bob
  submitMustFail (actAs actors <> readAs [e.adminA, e.adminB]) $
    exerciseCmd xRetry (enactArg "settle" actors) *>
    exerciseCmd yRetry (enactArg "wrong-rule" actors)
  checkLive e.alice "dvp-rollback-x" x xSecond
  checkLive e.bob "dvp-rollback-y" y ySecond
  query @Token.Token e.alice >>= (=== beforeAlice)
  query @Token.Token e.bob >>= (=== beforeBob)
  corrected <- submitTree (actAs actors <> readAs [e.adminA, e.adminB]) $
    exerciseCmd xRetry (enactArg "settle" actors) *>
    exerciseCmd yRetry (enactArg "settle" actors)
  length corrected.rootEvents === 2
  (_, xRetryIds) <- checkEnactment e.alice "dvp-rollback-x" x xSecond (Some "settle") xLegs None corrected.rootEvents
  (_, yRetryIds) <- checkEnactment e.bob "dvp-rollback-y" y ySecond (Some "settle") yLegs None corrected.rootEvents
  length (dedup (xIds <> yIds <> xRetryIds <> yRetryIds)) === 4
  assertBalance e.bob (account e.bob) x.instrumentId 200.0
  assertBalance e.alice (account e.alice) y.instrumentId 100.0

-- | CIP section 4, item 2 variant: a venue enacts an approved DvP.
-- Alice and Bob each approve "settle" on both locks, in separate transactions
-- from their own wallets; the venue is the rule's only entitled enactor and
-- holds no `Guard_Parties` authority of its own, so it enacts both rules
-- together in one transaction only once Alice's and Bob's recorded
-- approvals have met the two-party guard on each.
--
-- CIP-TBD Security Considerations, "Recorded approvals": once a rule's
-- `Guard_Parties` threshold is met by recorded approvals, any single acting
-- party can enact it. If the enactors were Alice and Bob themselves, Bob
-- could enact X's settle alone -- after Alice approved it -- without ever
-- settling Y, breaking the DvP's atomicity. Naming only the venue as
-- enactor closes that gap for Alice and Bob, neither of whom can act alone;
-- atomicity across the two locks then rests on the venue, which could enact
-- one lock without the other.
test_example_dvpVenueEnactsApprovedSettle : Script ()
test_example_dvpVenueEnactsApprovedSettle = do
  e <- setup ()
  venue <- allocateParty "cl-venue"
  let actors = [e.alice, e.bob]
  let deadline = e.now `addRelTime` hours 2
  let policyGuard = CL.Guard_Parties actors 2
  let xLegs = [CL.Leg "settle" (account e.bob) 100.0 emptyMetadata]
  let yLegs = [CL.Leg "settle" (account e.alice) 50.0 emptyMetadata]
  let x = (termsFor e) with
        rules = [CL.Rule "settle" [venue] [CL.Alternative [policyGuard, CL.Guard_Before deadline]]
          (CL.Outcome_Release xLegs [])]
  let y = x with
        authorizer = account e.bob
        instrumentId = V2.InstrumentId e.adminB "Y"
        amount = 50.0
        rules = [CL.Rule "settle" [venue] [CL.Alternative [policyGuard, CL.Guard_Before deadline]]
          (CL.Outcome_Release yLegs [])]
  (xCid, xBacking) <- lockAccepted e.rulesA "dvp-venue-x" x
  (yCid, yBacking) <- lockAccepted e.rulesB "dvp-venue-y" y
  xApprovedByAlice <- submit e.alice $ exerciseCmd xCid $ approveArg "settle" [] [e.alice]
  (xCid2, _) <- asLocked xApprovedByAlice
  xApprovedByBoth <- submit e.bob $ exerciseCmd xCid2 $ approveArg "settle" [] [e.bob]
  (xCid3, _) <- asLocked xApprovedByBoth
  Some xView <- queryInterfaceContractId e.alice xCid3
  xView.approvals === [CL.Approval "settle" [] [e.alice, e.bob]]

  -- Both approvals are already recorded on X alone, meeting its two-party
  -- guard; Bob's own solo enactment still fails, with full authority and
  -- full visibility of X, because he is not X's entitled enactor.
  failsBecause (actAs [e.bob]) "an entitled enactor must act" $
    exerciseCmd xCid3 $ enactArg "settle" [e.bob]

  yApprovedByAlice <- submit e.alice $ exerciseCmd yCid $ approveArg "settle" [] [e.alice]
  (yCid2, _) <- asLocked yApprovedByAlice
  yApprovedByBoth <- submit e.bob $ exerciseCmd yCid2 $ approveArg "settle" [] [e.bob]
  (yCid3, _) <- asLocked yApprovedByBoth
  Some yView <- queryInterfaceContractId e.bob yCid3
  yView.approvals === [CL.Approval "settle" [] [e.alice, e.bob]]
  -- The venue is the sole entitled enactor of either rule but holds no
  -- `Guard_Parties` authority of its own; only Alice's and Bob's recorded
  -- approvals let its single-party enactment meet each rule's two-party guard.
  tree <- submitTree (actAs [venue] <> readAs [e.alice, e.bob]) $
    exerciseCmd xCid3 (enactArg "settle" [venue]) *>
    exerciseCmd yCid3 (enactArg "settle" [venue])
  length tree.rootEvents === 2
  (_, xIds) <- checkEnactment e.alice "dvp-venue-x" x (xCid3, xBacking) (Some "settle") xLegs None tree.rootEvents
  (_, yIds) <- checkEnactment e.bob "dvp-venue-y" y (yCid3, yBacking) (Some "settle") yLegs None tree.rootEvents
  length (dedup (xIds <> yIds)) === 2
  assertBalance e.bob (account e.bob) x.instrumentId 100.0
  assertBalance e.alice (account e.alice) y.instrumentId 50.0

-- | CIP section 4, item 3: Arbiter escrow.
-- Buyer locks 100.0 with an award rule enacted by Arbiter, guarded by
-- Guard_Parties [Arbiter] 1, and released only to Buyer and Seller accounts.
-- Expiry is t0 + 24h; expiry unlocks the remaining amount to Buyer.
test_example_arbiterEscrow : Script ()
test_example_arbiterEscrow = do
  e <- setup ()
  let buyer = e.alice
  let seller = e.bob
  let terms = (termsFor e) with
        rules = [CL.Rule "award" [e.arbiter] [CL.Alternative [CL.Guard_Parties [e.arbiter] 1]]
          (CL.Outcome_Release [] [account buyer, account seller])]
  let award legs = (enactArg "award" [e.arbiter]) with legs
  -- Buyer funds first; Seller separately accepts. Buyer's own account needs
  -- no acceptance, which lockAccepted verifies against the pending approvals.
  full <- lockAccepted e.rulesA "example-escrow-full" terms
  let fullLegs = [CL.Leg "full" (account seller) 100.0 emptyMetadata]
  fullTree <- submitTree e.arbiter $ exerciseCmd (fst full) $ award fullLegs
  (_, fullIds) <- checkEnactment buyer "example-escrow-full" terms full
    (Some "award") fullLegs None fullTree.rootEvents
  length fullIds === 1
  assertBalance seller (account seller) terms.instrumentId 100.0

  split <- lockAccepted e.rulesA "example-escrow-split" terms
  let splitLegs = [CL.Leg "seller" (account seller) 60.0 emptyMetadata, CL.Leg "buyer" (account buyer) 40.0 emptyMetadata]
  splitTree <- submitTree e.arbiter $ exerciseCmd (fst split) $ award splitLegs
  (_, splitIds) <- checkEnactment buyer "example-escrow-split" terms split
    (Some "award") splitLegs None splitTree.rootEvents
  -- The Buyer output is an unlocked holdings change, so only Seller's
  -- payment appears as a transfer leg, with matching sender and receiver sides.
  length splitIds === 1
  assertBalance seller (account seller) terms.instrumentId 160.0
  assertBalance buyer (account buyer) terms.instrumentId 40.0

  rejected <- lockAccepted e.rulesA "example-escrow-rejections" terms
  -- Charlie authorizes receiving in this attempted transaction, so rejection
  -- must come from the agreed receiver list, not missing account authority.
  let outsideActors = [e.arbiter, e.charlie]
  submitMustFail outsideActors $ exerciseCmd (fst rejected) $
    (enactArg "award" outsideActors) with legs = [CL.Leg "outside" (account e.charlie) 100.0 emptyMetadata]
  checkLive buyer "example-escrow-rejections" terms rejected
  submitMustFail e.arbiter $ exerciseCmd (fst rejected) $
    award [CL.Leg "seller" (account seller) 60.01 emptyMetadata, CL.Leg "buyer" (account buyer) 40.0 emptyMetadata]
  checkLive buyer "example-escrow-rejections" terms rejected
  forA_ [buyer, seller] $ \actor -> do
    submitMustFail actor $ exerciseCmd (fst rejected) $
      (enactArg "award" [actor]) with legs = fullLegs
    checkLive buyer "example-escrow-rejections" terms rejected
  assertBalance seller (account seller) terms.instrumentId 160.0
  assertBalance buyer (account buyer) terms.instrumentId 40.0

  partial <- lockAccepted e.rulesA "example-escrow-partial" terms
  let partialLegs = [CL.Leg "partial" (account seller) 30.0 emptyMetadata]
  let remaining = terms with amount = 70.0; rules = []
  partialTree <- submitTree e.arbiter $ exerciseCmd (fst partial) $ award partialLegs
  (next, partialIds) <- checkEnactment buyer "example-escrow-partial" terms partial
    (Some "award") partialLegs (Some remaining) partialTree.rootEvents
  length partialIds === 1
  assertBalance seller (account seller) terms.instrumentId 190.0
  let continuation = fromSome next
  -- A partial release consumes the sole award rule as well as 30.0.
  submitMustFail e.arbiter $ exerciseCmd (fst continuation) $ award partialLegs
  checkLive buyer "example-escrow-partial" remaining continuation
  setTime remaining.expiresAt
  expiryTree <- submitTree buyer $ exerciseCmd (fst continuation) $
    CL.ConditionalLock_Expire [buyer] extra
  (_, expiryIds) <- checkEnactment buyer "example-escrow-partial" remaining continuation
    None [CL.Leg "expire" (account buyer) 70.0 emptyMetadata] None expiryTree.rootEvents
  expiryIds === []
  assertBalance buyer (account buyer) terms.instrumentId 110.0

-- | CIP section 4, item 4: Vesting.
-- Grantor locks 100.0 for Grantee in four 25.0 release rules, tranche-1
-- through tranche-4, enacted by Grantee and guarded by Guard_After at
-- t0 + 1h, +2h, +3h, and +4h. Expiry is t0 + 48h; expiry returns any
-- remaining amount to Grantor, unlocked.
test_example_vesting : Script ()
test_example_vesting = do
  e <- setup ()
  let grantor = e.alice
  let grantee = e.bob
  let legsFor k = [CL.Leg ("tranche-" <> show k) (account grantee) 25.0 emptyMetadata]
  let termsAt t0 = (termsFor e) with
        rules = [CL.Rule ("tranche-" <> show k) [grantee]
          [CL.Alternative [CL.Guard_After (t0 `addRelTime` hours k)]]
          (CL.Outcome_Release (legsFor k) []) | k <- [1 .. 4]]
        expiresAt = t0 `addRelTime` hours 48
        requestedAt = t0 `addRelTime` seconds (-1)
  let terms = termsAt e.now
  -- Grantor funds first and Grantee accepts in a separate submission.
  initial <- lockAccepted e.rulesA "example-vesting-complete" terms
  submitMustFail grantee $ exerciseCmd (fst initial) $ enactArg "tranche-1" [grantee]
  checkLive grantor "example-vesting-complete" terms initial

  setTime (e.now `addRelTime` hours 1)
  let afterFirst = terms with amount = 75.0; rules = drop 1 terms.rules
  firstTree <- submitTree grantee $ exerciseCmd (fst initial) $ enactArg "tranche-1" [grantee]
  (firstNext, firstIds) <- checkEnactment grantor "example-vesting-complete" terms initial
    (Some "tranche-1") (legsFor 1) (Some afterFirst) firstTree.rootEvents
  let first = fromSome firstNext
  assertBalance grantee (account grantee) terms.instrumentId 25.0
  submitMustFail grantee $ exerciseCmd (fst first) $ enactArg "tranche-1" [grantee]
  checkLive grantor "example-vesting-complete" afterFirst first

  setTime (e.now `addRelTime` hours 2)
  let afterSecond = terms with amount = 50.0; rules = drop 2 terms.rules
  secondTree <- submitTree grantee $ exerciseCmd (fst first) $ enactArg "tranche-2" [grantee]
  (secondNext, secondIds) <- checkEnactment grantor "example-vesting-complete" afterFirst first
    (Some "tranche-2") (legsFor 2) (Some afterSecond) secondTree.rootEvents
  let second = fromSome secondNext
  assertBalance grantee (account grantee) terms.instrumentId 50.0

  setTime (e.now `addRelTime` hours 3)
  let afterThird = terms with amount = 25.0; rules = drop 3 terms.rules
  thirdTree <- submitTree grantee $ exerciseCmd (fst second) $ enactArg "tranche-3" [grantee]
  (thirdNext, thirdIds) <- checkEnactment grantor "example-vesting-complete" afterSecond second
    (Some "tranche-3") (legsFor 3) (Some afterThird) thirdTree.rootEvents
  let third = fromSome thirdNext
  assertBalance grantee (account grantee) terms.instrumentId 75.0

  setTime (e.now `addRelTime` hours 4)
  fourthTree <- submitTree grantee $ exerciseCmd (fst third) $ enactArg "tranche-4" [grantee]
  (_, fourthIds) <- checkEnactment grantor "example-vesting-complete" afterThird third
    (Some "tranche-4") (legsFor 4) None fourthTree.rootEvents
  let lifecycleIds = firstIds <> secondIds <> thirdIds <> fourthIds
  length lifecycleIds === 4
  length (dedup lifecycleIds) === 4
  assertBalance grantee (account grantee) terms.instrumentId 100.0
  query @Impl.ActiveLock grantor >>= (=== [])
  query @Impl.LockedHolding grantor >>= (=== [])

  freshT0 <- getTime
  let freshTerms = termsAt freshT0
  fresh <- lockAccepted e.rulesA "example-vesting-expiry" freshTerms
  setTime (freshT0 `addRelTime` hours 1)
  let freshRemaining = freshTerms with amount = 75.0; rules = drop 1 freshTerms.rules
  freshTree <- submitTree grantee $ exerciseCmd (fst fresh) $ enactArg "tranche-1" [grantee]
  (freshNext, freshIds) <- checkEnactment grantor "example-vesting-expiry" freshTerms fresh
    (Some "tranche-1") (legsFor 1) (Some freshRemaining) freshTree.rootEvents
  length freshIds === 1
  let freshContinuation = fromSome freshNext
  setTime freshRemaining.expiresAt
  submitMustFail grantee $ exerciseCmd (fst freshContinuation) $ enactArg "tranche-2" [grantee]
  checkLive grantor "example-vesting-expiry" freshRemaining freshContinuation
  expiryTree <- submitTree grantor $ exerciseCmd (fst freshContinuation) $
    CL.ConditionalLock_Expire [grantor] extra
  (_, expiryIds) <- checkEnactment grantor "example-vesting-expiry" freshRemaining freshContinuation
    None [CL.Leg "expire" (account grantor) 75.0 emptyMetadata] None expiryTree.rootEvents
  expiryIds === []
  assertBalance grantor (account grantor) terms.instrumentId 75.0
  assertBalance grantee (account grantee) terms.instrumentId 125.0

-- | CIP section 4, item 5: Collateral.
-- Pledgor locks 100.0 until t0 + 24h; expiry returns the remaining amount to
-- Pledgor, unlocked. Pledgee may attest repayment and unlock, or take 100.0
-- on default from maturity t0 + 2h. Both parties may amend the collateral to
-- 150.0 and maturity t0 + 6h.
test_example_collateral : Script ()
test_example_collateral = do
  e <- setup ()
  let pledgor = e.alice
  let pledgee = e.bob
  let defaultRule maturity amount = CL.Rule "default" [pledgee]
        [CL.Alternative [CL.Guard_After maturity, CL.Guard_Parties [pledgee] 1]]
        (CL.Outcome_Release [CL.Leg "default" (account pledgee) amount emptyMetadata] [])
  let repaidRule = CL.Rule "repaid" [pledgee]
        [CL.Alternative [CL.Guard_Parties [pledgee] 1]] CL.Outcome_Unlock
  let termsAt t0 = (termsFor (e with now = t0)) with
        rules = [repaidRule, defaultRule (t0 `addRelTime` hours 2) 100.0]
  let repaidTerms = termsAt e.now
  -- Pledgor funds first; Pledgee separately accepts the default receiver role.
  -- Unlock adds no receiver and requires no further acceptance from Pledgor.
  termReceivers repaidTerms === [account pledgee]
  repaidHandle@(repaidCid, _) <- lockAccepted e.rulesA "example-collateral-repaid" repaidTerms
  submitMustFail pledgee $ exerciseCmd repaidCid $ enactArg "default" [pledgee]
  checkLive pledgor "example-collateral-repaid" repaidTerms repaidHandle
  repaidTree <- submitTree pledgee $ exerciseCmd repaidCid $ enactArg "repaid" [pledgee]
  (_, repaidIds) <- checkEnactment pledgor "example-collateral-repaid" repaidTerms repaidHandle
    (Some "repaid") [CL.Leg "unlock" (account pledgor) 100.0 emptyMetadata] None repaidTree.rootEvents
  repaidIds === []
  assertBalance pledgor (account pledgor) repaidTerms.instrumentId 100.0

  defaultT0 <- getTime
  let defaultTerms = termsAt defaultT0
  defaultHandle@(defaultCid, _) <- lockAccepted e.rulesA "example-collateral-default" defaultTerms
  -- Guard_After includes the exact maturity instant.
  setTime (defaultT0 `addRelTime` hours 2)
  defaultTree <- submitTree pledgee $ exerciseCmd defaultCid $ enactArg "default" [pledgee]
  (_, defaultIds) <- checkEnactment pledgor "example-collateral-default" defaultTerms defaultHandle
    (Some "default") [CL.Leg "default" (account pledgee) 100.0 emptyMetadata] None defaultTree.rootEvents
  length defaultIds === 1
  assertBalance pledgee (account pledgee) defaultTerms.instrumentId 100.0

  marginT0 <- getTime
  let marginTerms = termsAt marginT0
  marginHandle@(marginCid, oldBacking) <- lockAccepted e.rulesA "example-collateral-margin" marginTerms
  topUp <- mint marginTerms 50.0
  let newMaturity = marginT0 `addRelTime` hours 6
  let newTerms = marginTerms with
        amount = 150.0
        rules = [repaidRule, defaultRule newMaturity 150.0]
  let actors = [pledgor, pledgee]
  submitMustFail pledgor $ exerciseCmd marginCid $
    CL.ConditionalLock_Amend newTerms [topUp] [pledgor] extra
  submitMustFail actors $ exerciseCmd marginCid $
    CL.ConditionalLock_Amend (newTerms with instrumentId = V2.InstrumentId e.adminA "OTHER") [topUp] actors extra
  -- Keep the 160.0 proposal internally valid so this fails on conservation:
  -- 100.0 remaining plus 50.0 top-up funds only 150.0.
  let underfundedTerms = newTerms with
        amount = 160.0
        rules = [repaidRule, defaultRule newMaturity 160.0]
  submitMustFail actors $ exerciseCmd marginCid $
    CL.ConditionalLock_Amend underfundedTerms [topUp] actors extra
  checkLive pledgor "example-collateral-margin" marginTerms marginHandle
  assertToken pledgor topUp marginTerms.authorizer marginTerms.instrumentId 50.0

  (amended, marginTree) <- submitResultAndTree actors $ exerciseCmd marginCid $
    CL.ConditionalLock_Amend newTerms [topUp] actors extra
  amended.authorizerChangeCids === []
  assertConsumed pledgor marginCid oldBacking
  queryContractId pledgor (coerceContractId topUp : ContractId Token.Token) >>= (=== None)
  active <- query @Impl.ActiveLock pledgor
  case filter (\(_, lock) -> lock.state.lockId == "example-collateral-margin") active of
    [(nextCid, nextLock)] -> do
      let nextBacking = toInterfaceContractId nextLock.state.holdingCid : ContractId V2.Holding
      let nextHandle = (toInterfaceContractId nextCid, nextBacking)
      checkLive pledgor "example-collateral-margin" newTerms nextHandle
      nextLock.state.accepted === [account pledgee]
      Some backing <- queryInterfaceContractId pledgor nextBacking
      backing.amount === 150.0
      (fromSome backing.lock).expiresAt === Some newTerms.expiresAt
      case holdingsChanges marginTree.rootEvents of
        [changed] -> do
          changed.admin === newTerms.instrumentId.admin
          changed.account === account pledgor
          changed.inputHoldingCids === [oldBacking, topUp]
          changed.outputHoldingCids === [nextBacking]
          changed.transferLegSides === []
          TextMap.lookup (prefix <> "tx-kind") changed.extraArgs.meta.values === Some "lock"
        _ -> abort "expected one authorizer holdings change for collateral amendment"
    _ -> abort "expected one active amended collateral lock"

-- | CIP section 4, item 6: Conditional payment.
-- Payer locks 100.0 for Payee, who may enact pay only with Oracle attestation
-- strictly before deadline t0 + 2h. Expiry is t0 + 24h and simply returns the
-- funds to Payer, unlocked. Oracle is a named stakeholder, has no receiver
-- role, and never accepts.
test_example_conditionalPayment : Script ()
test_example_conditionalPayment = do
  e <- setup ()
  let payer = e.alice
  let payee = e.bob
  let oracle = e.arbiter
  let termsAt t0 = (termsFor (e with now = t0)) with
        rules = [CL.Rule "pay" [payee]
          [CL.Alternative [CL.Guard_Parties [oracle] 1, CL.Guard_Before (t0 `addRelTime` hours 2)]]
          (CL.Outcome_Release [CL.Leg "payment" (account payee) 100.0 emptyMetadata] [])]
  let terms = termsAt e.now
  termReceivers terms === [account payee]
  assert (oracle `elem` namedParties terms)
  paidHandle@(paidCid, _) <- lockAccepted e.rulesA "example-conditional-payment-paid" terms
  -- Oracle can see the lock and its backing as a stakeholder without accepting.
  checkLive oracle "example-conditional-payment-paid" terms paidHandle
  Some active <- queryContractId oracle (coerceContractId paidCid : ContractId Impl.ActiveLock)
  active.state.accepted === [account payee]
  -- Before the oracle attests, no alternative is satisfied for the payee alone.
  failsBecause (actAs [payee]) "no alternative is satisfied" $ exerciseCmd paidCid $ enactArg "pay" [payee]
  submitMustFail oracle $ exerciseCmd paidCid $ enactArg "pay" [oracle]
  checkLive payer "example-conditional-payment-paid" terms paidHandle
  -- The oracle attests from its own wallet, in a transaction separate from the
  -- payee's later enactment.
  approved <- submit oracle $ exerciseCmd paidCid $ approveArg "pay" [] [oracle]
  (approvedCid, _) <- asLocked approved
  Some approvedView <- queryInterfaceContractId payer approvedCid
  approvedView.approvals === [CL.Approval "pay" [] [oracle]]
  let approvedHandle = (approvedCid, snd paidHandle)
  paidTree <- submitTree payee $ exerciseCmd approvedCid $ enactArg "pay" [payee]
  (_, paidIds) <- checkEnactment payer "example-conditional-payment-paid" terms approvedHandle
    (Some "pay") [CL.Leg "payment" (account payee) 100.0 emptyMetadata] None paidTree.rootEvents
  length paidIds === 1
  assertBalance payee (account payee) terms.instrumentId 100.0

  expiredT0 <- getTime
  let expiredTerms = termsAt expiredT0
  expiredHandle@(expiredCid, _) <- lockAccepted e.rulesA "example-conditional-payment-expired" expiredTerms
  setTime (expiredT0 `addRelTime` hours 2)
  submitMustFail [payee, oracle] $ exerciseCmd expiredCid $ enactArg "pay" [payee, oracle]
  checkLive payer "example-conditional-payment-expired" expiredTerms expiredHandle
  assertBalance payee (account payee) expiredTerms.instrumentId 100.0
  setTime expiredTerms.expiresAt
  expiredTree <- submitTree payer $ exerciseCmd expiredCid $
    CL.ConditionalLock_Expire [payer] extra
  (_, expiredIds) <- checkEnactment payer "example-conditional-payment-expired" expiredTerms expiredHandle
    None [CL.Leg "expire" (account payer) 100.0 emptyMetadata] None expiredTree.rootEvents
  expiredIds === []
  assertBalance payer (account payer) expiredTerms.instrumentId 100.0
