module TestHashVectors where

import DA.Assert
import DA.Foldable (forA_)
import DA.Text qualified as Text
import DA.Crypto.Text qualified as Crypto
import Daml.Script
import Splice.Api.Token.ConditionalLockV1 qualified as CL
import ConditionalLock.Policy (hashPreimage)
import Generated.HashVectors (vectors)

test_hashVectorsMatchEvm : Script ()
test_hashVectorsMatchEvm = forA_ vectors $ \(_, preimage, sha, keccak) -> do
  Crypto.sha256 preimage === sha
  Crypto.keccak256 preimage === keccak
  hashPreimage CL.Sha256 preimage === Some sha
  hashPreimage CL.Keccak256 preimage === Some keccak
  hashPreimage CL.Sha256 (Text.asciiToUpper preimage) === Some sha
  hashPreimage CL.Keccak256 (Text.asciiToUpper preimage) === Some keccak
  assert (Text.sha256 preimage /= sha)

test_invalidPreimagesAreRejectedBeforeHashing : Script ()
test_invalidPreimagesAreRejectedBeforeHashing = do
  let zero = repeatText 64 "0"
  forA_ ["", "00", repeatText 63 "0", repeatText 65 "0", "0x" <> zero,
          repeatText 64 "g", repeatText 64 "é", zero <> " "] $ \preimage -> do
    hashPreimage CL.Sha256 preimage === None
    hashPreimage CL.Keccak256 preimage === None

repeatText : Int -> Text -> Text
repeatText n t = Text.implode (replicate n t)
